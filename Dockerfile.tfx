# Dockerfile for TFX pipeline execution

# Dockerfile for TFX pipeline execution

# Use the official TFX 1.12.0 image. This image comes with all compatible
# dependencies (TFX, TensorFlow, Beam, tfx-bsl) pre-installed, avoiding
# platform-specific installation issues.
# Use TFX 1.14.0, which has better multi-platform support for arm64 (Apple Silicon)
FROM tensorflow/tfx:1.14.0

# Set the working directory inside the container
WORKDIR /pipeline

# Copy only the user's pipeline code into the container.
# The base image already contains the TFX libraries.
COPY tfx_pipeline/ /pipeline/tfx_pipeline/

# The base image's entrypoint is already configured.
# We will specify the command to run directly in the `docker run` command.
